{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "business-website-starter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
  },
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
}
